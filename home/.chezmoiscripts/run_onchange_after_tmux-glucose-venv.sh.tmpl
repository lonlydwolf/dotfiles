#!/bin/sh
# .venv has machine-specific paths, so it's regenerated, not committed.
# requirements.txt hash: {{ include "dot_config/tmux/scripts/requirements.txt" | sha256sum }}
set -eu

dir="$HOME/.config/tmux/scripts"
python3 -m venv "$dir/.venv"
"$dir/.venv/bin/pip" install --quiet --upgrade pip
"$dir/.venv/bin/pip" install --quiet -r "$dir/requirements.txt"
