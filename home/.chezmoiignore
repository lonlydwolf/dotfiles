{{/* templated — per-OS ignores added below */}}
# chezmoi's own dir (age key + generated config)
.config/chezmoi/**

# machine-generated / build artifacts — never track
**/target
**/.venv
**/__pycache__
**/node_modules
**/.zsh_history

# ya-managed plugins are regenerated by `ya pkg install`; only local plugins are tracked
.config/yazi/plugins/*
!.config/yazi/plugins/folder-rules.yazi

# No age identity yet (bootstrap's "continue without secrets"): skip the
# encrypted targets so apply still writes everything else. They come back on
# the first apply after the key is restored. Every new encrypted_* file must be
# listed here too, or apply fails on a keyless machine.
{{ if not (stat .chezmoi.config.age.identity) }}
.config/secrets/api-keys
.config/cgm/.env
{{ end }}
