# ~/.zshenv — the only zsh file allowed in $HOME.
# Read first on every zsh invocation, before ZDOTDIR is known, so this is the
# one correct place to relocate the rest of zsh's config under XDG.
# Managed by chezmoi as dot_zshenv.

# Keep PATH free of duplicates across nested shells (tmux, subshells, exec zsh).
# Set before any PATH edits so every later prepend is auto-deduped.
typeset -U path PATH

# ---------- XDG base directories ----------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# ---------- Relocate zsh itself ----------
# Everything else (.zshrc, aliases, plugins…) lives here.
[[ -d "$XDG_CONFIG_HOME/zsh" ]] && export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# .zshenv is the first startup file and can't relocate itself, so source the
# real one explicitly (this is why it isn't auto-loaded from ZDOTDIR).
[[ -r "$ZDOTDIR/.zshenv" ]] && source "$ZDOTDIR/.zshenv"
